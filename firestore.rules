rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny: Interdire tout accès par défaut.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(data) {
      return isSignedIn() && data.userId == request.auth.uid;
    }

    function isValidOrder(data) {
      return data.prixTotal >= 0
        && data.acompte >= 0
        && (!('coutMateriaux' in data) || data.coutMateriaux >= 0)
        && (!('coutMainDoeuvre' in data) || data.coutMainDoeuvre >= 0)
        && (!('coutTransport' in data) || data.coutTransport >= 0);
    }

    function isValidPayment(data) {
      return data.montant > 0;
    }

    function isValidStock(data) {
      return data.quantite >= 0
        && data.seuilAlerte >= 0
        && data.coutUnitaire >= 0;
    }

    match /ateliers/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /clients/{docId} {
      allow read, delete: if isOwner(resource.data);
      allow update: if isOwner(resource.data) && isOwner(request.resource.data);
      allow create: if isOwner(request.resource.data);
    }

    match /commandes/{docId} {
      allow read, delete: if isOwner(resource.data);
      allow update: if isOwner(resource.data) && isOwner(request.resource.data) && isValidOrder(request.resource.data);
      allow create: if isOwner(request.resource.data) && isValidOrder(request.resource.data);
    }

    match /paiements/{docId} {
      allow read, delete: if isOwner(resource.data);
      allow update: if isOwner(resource.data) && isOwner(request.resource.data) && isValidPayment(request.resource.data);
      allow create: if isOwner(request.resource.data) && isValidPayment(request.resource.data);
    }

    match /fiches/{docId} {
      allow read, delete: if isOwner(resource.data);
      allow update: if isOwner(resource.data) && isOwner(request.resource.data);
      allow create: if isOwner(request.resource.data);
    }

    match /modeles/{docId} {
      allow read, delete: if isOwner(resource.data);
      allow update: if isOwner(resource.data) && isOwner(request.resource.data);
      allow create: if isOwner(request.resource.data);
    }

    match /stock/{docId} {
      allow read, delete: if isOwner(resource.data);
      allow update: if isOwner(resource.data) && isOwner(request.resource.data) && isValidStock(request.resource.data);
      allow create: if isOwner(request.resource.data) && isValidStock(request.resource.data);
    }

    match /historique_modifications/{docId} {
      allow read, delete: if isOwner(resource.data);
      allow create: if isOwner(request.resource.data);
    }

    match /compteurs/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
